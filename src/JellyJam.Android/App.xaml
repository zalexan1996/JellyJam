<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JellyJam.Mobile.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Ink">#080C10</Color>
      <Color x:Key="Surface">#101A1F</Color>
      <Color x:Key="Signal">#71F7F3</Color>
      <Color x:Key="Accent">#FF69D4</Color>
      <Color x:Key="Paper">#F0F6F7</Color>
      <Color x:Key="Muted">#9AAEB5</Color>
      <Color x:Key="Warning">#FFC36A</Color>
      <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
      </Style>
      <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Paper}" />
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="FontSize" Value="16" />
      </Style>
      <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="SpaceMono" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
      </Style>
      <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{StaticResource Paper}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="HeightRequest" Value="56" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Signal}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinimumHeightRequest" Value="54" />
      </Style>
      <Style TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="BorderColor" Value="#30484E" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="16" />
      </Style>
      <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Paper}" />
        <Setter Property="TitleColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="MinimumHeightRequest" Value="52" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>