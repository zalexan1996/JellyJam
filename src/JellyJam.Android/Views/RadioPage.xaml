<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JellyJam.Mobile.ViewModels"
             xmlns:views="clr-namespace:JellyJam.Mobile.Views"
             x:Class="JellyJam.Mobile.Views.RadioPage"
             x:DataType="vm:RadioViewModel"
             SafeAreaEdges="All" BackgroundColor="{StaticResource Ink}">
  <Grid>
  <views:LogBackdropView x:Name="LogBackdrop" />
  <ScrollView>
    <Grid Padding="24,20,24,28" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="22" MaximumWidthRequest="520" HorizontalOptions="Fill">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
        <Label Text="JELLYJAM" FontSize="32" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
        <ImageButton Grid.Column="1" Source="log_out.png" Command="{Binding SignOutCommand}" IsVisible="{Binding ShowRadio}"
                     IsEnabled="{Binding CanInteract}" SemanticProperties.Description="Sign out" ToolTipProperties.Text="Sign out" />
        <Label Grid.Row="1" Text="JELLYFIN RADIO" Style="{StaticResource Caption}" TextColor="{StaticResource Signal}" />
        <BoxView Grid.Row="1" Grid.Column="1" BackgroundColor="{StaticResource Accent}" HeightRequest="2" WidthRequest="44" VerticalOptions="Center" />
      </Grid>

      <VerticalStackLayout Grid.Row="1" Spacing="22" IsVisible="{Binding ShowLogin}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,8,0,8">
          <Image Source="radio.png" WidthRequest="48" HeightRequest="48" SemanticProperties.Description="JellyJam radio" />
          <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
            <Label Text="Sign in" FontSize="26" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
            <Label Text="Your Jellyfin server" TextColor="{StaticResource Muted}" />
          </VerticalStackLayout>
        </Grid>
        <VerticalStackLayout Spacing="8">
          <Label Text="SERVER URL" Style="{StaticResource Caption}" />
          <Entry Text="{Binding ServerUrl}" Placeholder="https://music.example.com" Keyboard="Url" ReturnType="Next"
                 IsTextPredictionEnabled="False" IsSpellCheckEnabled="False" SemanticProperties.Description="Jellyfin server URL" />
        </VerticalStackLayout>
        <Grid IsVisible="{Binding IsInsecure}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <CheckBox IsChecked="{Binding AllowHttp}" Color="{StaticResource Warning}" SemanticProperties.Description="Allow unencrypted HTTP" />
          <Label Grid.Column="1" Text="Allow unencrypted HTTP" TextColor="{StaticResource Warning}" FontSize="14" VerticalOptions="Center" />
        </Grid>
        <VerticalStackLayout Spacing="8">
          <Label Text="USERNAME" Style="{StaticResource Caption}" />
          <Entry Text="{Binding UserName}" Placeholder="Username" ReturnType="Next" IsTextPredictionEnabled="False"
                 IsSpellCheckEnabled="False" SemanticProperties.Description="Jellyfin username" />
        </VerticalStackLayout>
        <VerticalStackLayout Spacing="8">
          <Label Text="PASSWORD" Style="{StaticResource Caption}" />
          <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" ReturnType="Go"
                 ReturnCommand="{Binding SignInCommand}" SemanticProperties.Description="Jellyfin password" />
        </VerticalStackLayout>
        <Button Text="Sign in" Command="{Binding SignInCommand}" IsEnabled="{Binding CanInteract}" Margin="0,6,0,0" />
      </VerticalStackLayout>

      <VerticalStackLayout Grid.Row="1" Spacing="20" IsVisible="{Binding ShowRadio}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <BoxView Color="{StaticResource Signal}" HeightRequest="6" WidthRequest="6" VerticalOptions="Center" />
          <Label Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Caption}" TextColor="{StaticResource Signal}" />
        </Grid>
        <Grid RowDefinitions="32,100" RowSpacing="0">
          <Grid ColumnDefinitions="*,Auto">
            <Label Text="SPECTRUM / 32" Style="{StaticResource Caption}" TextColor="{StaticResource Signal}" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding SpectrumEnabled}" IsEnabled="{Binding CanToggleSpectrum}"
                    OnColor="{StaticResource Signal}" ThumbColor="{StaticResource Accent}"
                    SemanticProperties.Description="Enable music spectrum" />
          </Grid>
          <views:SpectrumView x:Name="Spectrum" Grid.Row="1" IsVisible="{Binding ShowRadio}"
                              IsSpectrumEnabled="{Binding SpectrumEnabled}" />
        </Grid>
        <Grid Padding="2" BackgroundColor="Black">
        <VerticalStackLayout Spacing="18" Padding="18">
        <VerticalStackLayout Spacing="10">
          <Label Text="{Binding TrackTitle}" FontSize="29" FontAttributes="Bold" LineBreakMode="WordWrap" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{Binding Artist}" FontSize="19" TextColor="{StaticResource Accent}" LineBreakMode="WordWrap" />
          <Label Text="{Binding Album}" FontSize="14" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
        <VerticalStackLayout Spacing="12">
          <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Signal}" BackgroundColor="#25363B" HeightRequest="4"
                       SemanticProperties.Description="Track playback progress" />
          <Label Text="{Binding PositionText}" Style="{StaticResource Caption}" HorizontalOptions="End" />
        </VerticalStackLayout>
        </VerticalStackLayout>
        <views:GlitchBorderView />
        </Grid>
        <Grid ColumnDefinitions="56,80,56" ColumnSpacing="24" HorizontalOptions="Center" HeightRequest="80" IsEnabled="{Binding CanInteract}">
          <ImageButton Source="skip_back.png" Command="{Binding PreviousCommand}" VerticalOptions="Center" IsEnabled="{Binding CanNavigate}"
                       SemanticProperties.Description="Previous track" ToolTipProperties.Text="Previous track" />
          <ImageButton Grid.Column="1" Source="{Binding PlaybackIcon}" Command="{Binding TogglePlaybackCommand}"
                       HeightRequest="80" WidthRequest="80" Padding="25" BackgroundColor="#173033" BorderColor="{StaticResource Signal}"
                       SemanticProperties.Description="{Binding PlaybackDescription}" ToolTipProperties.Text="{Binding PlaybackDescription}" />
          <ImageButton Grid.Column="2" Source="skip_forward.png" Command="{Binding NextCommand}" VerticalOptions="Center" IsEnabled="{Binding CanNavigate}"
                       SemanticProperties.Description="Next track" ToolTipProperties.Text="Next track" />
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="8" IsEnabled="{Binding CanInteract}">
          <Label Text="RANDOM" Style="{StaticResource Caption}" />
          <Label Grid.Column="1" Text="REPEAT" Style="{StaticResource Caption}" />
          <Picker Grid.Row="1" ItemsSource="{Binding RandomOptions}" SelectedItem="{Binding RandomName}" Title="Random mode"
                  SemanticProperties.Description="Random selection mode" />
          <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding RepeatName}" Title="Repeat mode"
                  SemanticProperties.Description="Repeat mode" />
        </Grid>
        <BoxView Color="#25363B" HeightRequest="1" />
        <Label Text="{Binding Account}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" MaxLines="1" />
      </VerticalStackLayout>

      <ActivityIndicator Grid.Row="2" IsRunning="{Binding Initializing}" IsVisible="{Binding Initializing}" Color="{StaticResource Signal}" HeightRequest="32" />
      <VerticalStackLayout Grid.Row="3" Spacing="12">
        <ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" Color="{StaticResource Signal}" HeightRequest="24" />
        <Label Text="{Binding ErrorMessage}" FontSize="14" TextColor="{StaticResource Warning}" LineBreakMode="WordWrap"
               SemanticProperties.Description="{Binding ErrorMessage}" />
      </VerticalStackLayout>
    </Grid>
  </ScrollView>
  </Grid>
</ContentPage>